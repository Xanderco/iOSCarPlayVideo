    },
    "Automatic trip detection, route replay, and telemetry. Everything stays on your device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic trip detection, route replay, and telemetry. Everything stays on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detección automática de viajes, repetición de rutas y telemetría. Todo se queda en tu dispositivo."
          }
        }
      }
    },
    "Safety first — passengers only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety first — passengers only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La seguridad es lo primero: solo pasajeros"
          }
        }
      }
    },
    "Video playback is strictly for passengers or while parked. Never watch video while driving.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video playback is strictly for passengers or while parked. Never watch video while driving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción de vídeo es estrictamente para pasajeros o mientras está aparcado. Nunca veas vídeos mientras conduces."
          }
        }
      }
    },
    "I won't watch or operate DashCast while driving.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
