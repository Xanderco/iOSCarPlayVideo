    "Play your own videos and channels on the car display while you're parked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play your own videos and channels on the car display while you're parked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce tus propios vídeos y canales en la pantalla del coche mientras estás aparcado."
          }
        }
      }
    },
    "Bring your own sources": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your own sources"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae tus propias fuentes"
          }
        }
      }
    },
    "M3U and M3U8 playlists, Jellyfin and Emby servers, your Files and Photos. DashCast includes no channels of its own.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U and M3U8 playlists, Jellyfin and Emby servers, your Files and Photos. DashCast includes no channels of its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas M3U y M3U8, servidores Jellyfin y Emby, tus Archivos y Fotos. DashCast no incluye canales propios."
          }
        }
      }
    },
    "Every trip, remembered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every trip, remembered"
