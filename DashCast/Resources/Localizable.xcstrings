    "Follow these 4 simple steps in Apple's Shortcuts app to trigger your car personality sounds automatically whenever you get in or out of your car.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow these 4 simple steps in Apple's Shortcuts app to trigger your car personality sounds automatically whenever you get in or out of your car."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue estos 4 sencillos pasos en la app Atajos de Apple para activar los sonidos de tu coche automáticamente cada vez que entres o salgas de él."
          }
        }
      }
    },
    "Open Apple Shortcuts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Apple Shortcuts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Atajos de Apple"
          }
        }
      }
    },
    "Open the pre-installed 'Shortcuts' app on your iPhone and tap the 'Automation' tab at the bottom center.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the pre-installed 'Shortcuts' app on your iPhone and tap the 'Automation' tab at the bottom center."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app 'Atajos' preinstalada en tu iPhone y toca la pestaña 'Automatización' en la parte inferior central."
          }
        }
      }
    },
    "Create CarPlay Automation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create CarPlay Automation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear automatización de CarPlay"
          }
        }
      }
    },
    "Tap '+' (New Automation) and select 'CarPlay' (or 'Bluetooth'). Choose 'When CarPlay Connects' and select 'Run Immediately' (disable 'Ask Before Running').": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap '+' (New Automation) and select 'CarPlay' (or 'Bluetooth'). Choose 'When CarPlay Connects' and select 'Run Immediately' (disable 'Ask Before Running')."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca '+' (Nueva automatización) y selecciona 'CarPlay' (o 'Bluetooth'). Elige 'Al conectar CarPlay' y selecciona 'Ejecutar inmediatamente' (desactiva 'Solicitar confirmación')."
          }
        }
      }
    },
    "Add DashCast Action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add DashCast Action"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir acción de DashCast"
          }
        }
      }
    },
    "Tap 'New Blank Automation', search for 'DashCast' or 'Open App', and add the 'Play Connection Sound' intent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap 'New Blank Automation', search for 'DashCast' or 'Open App', and add the 'Play Connection Sound' intent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca 'Nueva automatización en blanco', busca 'DashCast' o 'Abrir app', y añade la acción 'Reproducir sonido de conexión'."
          }
        }
      }
    },
    "Done! Enjoy the Experience": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done! Enjoy the Experience"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Listo! Disfruta de la experiencia"
          }
        }
      }
    },
    "Whenever your iPhone plugs into or connects wirelessly to CarPlay, your chosen sound will immediately play through your car's stereo system!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whenever your iPhone plugs into or connects wirelessly to CarPlay, your chosen sound will immediately play through your car's stereo system!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que conectes tu iPhone por cable o de forma inalámbrica a CarPlay, ¡el sonido elegido sonará inmediatamente a través del sistema de audio de tu coche!"
          }
        }
      }
    },
