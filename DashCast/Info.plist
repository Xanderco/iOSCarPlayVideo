<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.xanderco.dashcast</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dashcast</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDisplayName</key>
	<string>DashCast</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Drive uses your location to centre the map on you and record the route and distance of your trips. Trips stay on this iPhone.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Lets Drive notice when you start driving and record the trip automatically, even when DashCast is closed. Trips stay on this iPhone.</string>
	<key>NSMotionUsageDescription</key>
	<string>DashCast uses motion activity to tell when you are driving, so it can record trips automatically and pause video on a car display while the car is moving.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Owner decision 2026-11-05: DashCast plays user-supplied playlists (M3U, iptv-org, QR links)
		     and personal media servers (Jellyfin/Emby), which are frequently plain http; the app ships
		     no content. NSAllowsArbitraryLoads covers playlist downloads, AVFoundation streams, LAN and
		     remote http servers. IMPORTANT: do NOT add NSAllowsArbitraryLoadsForMedia,
		     NSAllowsArbitraryLoadsInWebContent or NSAllowsLocalNetworking next to it: on iOS 10+ the
		     presence of any of them makes iOS IGNORE NSAllowsArbitraryLoads, and http playlist
		     downloads fail again. Enforced by ReviewFixesTests.testATSAllowsUserSuppliedHTTPSources.
		     Review justification: AppStoreMedia/metadata.md section 9. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>DashCast uses the camera to scan QR codes that contain IPTV playlist links.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>DashCast accesses your photos so you can pick videos and photos to play or show on the car screen.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>DashCast connects to media servers on your local network, such as a Jellyfin or Emby server at home, and can mirror your screen to your parked car's browser display.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
			<key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>ExternalDisplay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).ExternalDisplaySceneDelegate</string>
				</dict>
			</array>
			<key>CPTemplateApplicationDashboardSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>CarPlayDashboard</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlayDashboardSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
